PORT=8877
# HOST=127.0.0.1
# Keep single-user when upgrading an original dashboard.
PM2_MONITOR_MODE=single-user
ADMIN_PASSWORD=replace-with-your-dashboard-password
# Generate a different value for each instance: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Used only in multi-user. Relative paths resolve from the project root.
PM2_MONITOR_TARGETS_FILE=./config/pm2-targets.json
# Optional alternative to passwords stored by the target management UI:
# APPUSER_DASHBOARD_PASSWORD=replace-with-target-dashboard-password
